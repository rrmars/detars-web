---
/**
 * TarotSpread — three tarot cards for the homepage phone mockup, styled after
 * the desktop app's TarotTable (metaphysics-tarot.css): gold line art on ink,
 * the same card back, the same springy rotateY flip and glint.
 *
 * Backs show until an ancestor carries data-phase="3"; then the cards flip in
 * turn (0 / 0.25 / 0.5 s). Without JS motion (<html> lacking .motion) or with
 * reduced motion, the faces simply show.
 */
import { tarotBackSvg, tarotFaceSvg, type TarotFaceKey } from "../../lib/home-tarot-art";

interface Props {
  labels: { pos: string; name: string }[];
}

const { labels } = Astro.props;
const KEYS: TarotFaceKey[] = ["eight-of-swords", "knight-of-wands", "the-star"];
const cards = KEYS.map((key, i) => ({ key, pos: labels[i]?.pos ?? "", name: labels[i]?.name ?? "" }));
---

<div class="spread">
  {cards.map((card, i) => (
    <div class="card" style={`--i:${i}`}>
      <span class="pos">{card.pos}</span>
      <span class="inner">
        <span class="side back" aria-hidden="true" set:html={tarotBackSvg} />
        <span class="side front">
          <span class="art" aria-hidden="true" set:html={tarotFaceSvg(card.key)} />
          <span class="name">{card.name}</span>
        </span>
      </span>
    </div>
  ))}
</div>

<style>
  .spread {
    display: flex;
    gap: 10px;
    justify-content: center;
  }

  .card {
    display: grid;
    gap: 4px;
    justify-items: center;
    perspective: 600px;
  }

  .pos {
    color: rgba(239, 233, 220, 0.5);
    font-size: 9px;
    letter-spacing: 0.2em;
    line-height: 1.3;
    max-width: 62px;
    text-align: center;
  }

  .inner {
    display: block;
    height: 100px;
    position: relative;
    transform: rotateY(0deg);
    transform-style: preserve-3d;
    transition: transform 760ms cubic-bezier(0.3, 1.35, 0.45, 1);
    transition-delay: calc(var(--i) * 250ms);
    width: 62px;
  }

  .side {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 6px;
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.45);
    inset: 0;
    overflow: hidden;
    position: absolute;
  }

  .back { border: 1px solid rgba(246, 217, 138, 0.4); }

  .side :global(svg) {
    display: block;
    height: 100%;
    width: 100%;
  }

  .front {
    background: linear-gradient(170deg, #2a2340, #161226);
    border: 1px solid rgba(246, 217, 138, 0.55);
    display: grid;
    grid-template-rows: 1fr auto;
    padding: 5px 4px 4px;
    text-align: center;
    transform: rotateY(180deg);
  }

  .art { display: grid; min-height: 0; place-items: center; }

  .name {
    color: #f6d98a;
    font-family: "Songti SC", "Noto Serif SC", "Source Han Serif SC", serif;
    font-size: 9px;
    letter-spacing: 0.04em;
    line-height: 1.15;
  }

  /* Glint sweeps the face once it has turned (desktop: 420ms into the flip). */
  .front::after {
    background: linear-gradient(105deg, transparent 40%, rgba(255, 240, 200, 0.5) 50%, transparent 60%);
    content: "";
    inset: -40%;
    opacity: 0;
    pointer-events: none;
    position: absolute;
  }

  :global([data-phase="3"]) .inner {
    transform: rotateY(180deg);
  }

  :global([data-phase="3"]) .front::after {
    animation: home-tarot-glint 900ms ease-out both;
    animation-delay: calc(var(--i) * 250ms + 420ms);
  }

  :global(html:not(.motion)) .inner { transform: rotateY(180deg); transition: none; }
  :global(html:not(.motion)) .front::after { animation: none; }

  @media (prefers-reduced-motion: reduce) {
    .inner,
    :global([data-phase="3"]) .inner {
      transform: rotateY(180deg);
      transition: none;
    }

    .front::after,
    :global([data-phase="3"]) .front::after {
      animation: none;
    }
  }

  @keyframes home-tarot-glint {
    from { opacity: 1; transform: translateX(-60%); }
    to { opacity: 0; transform: translateX(60%); }
  }
</style>
