---
import { footerGroups, footerHref } from "@/lib/nav";
import { scenarioChrome } from "@/lib/scenario-i18n";
import { isScenarioOnly, withLocale, type AnyLocale, type Locale } from "@/lib/site";
import { t } from "@/lib/ui-labels";

type Props = { locale: AnyLocale };
const { locale } = Astro.props;
const chrome = isScenarioOnly(locale) ? scenarioChrome[locale] : undefined;
// Scenario-only locales: localized scenarios link, everything else points at the English pages.
const tagline = chrome ? chrome.tagline : t("footerTagline", locale as Locale);
const sub = chrome ? chrome.sub : t("footerSub", locale as Locale);
const soloLinks = chrome ? [
  { href: withLocale(locale, "/scenarios"), label: chrome.scenarios, english: false },
  { href: withLocale("en", "/"), label: chrome.englishSite, english: true },
  { href: withLocale("en", "/pricing"), label: chrome.pricing, english: true },
  { href: withLocale("en", "/terms"), label: chrome.terms, english: true },
  { href: withLocale("en", "/privacy"), label: chrome.privacy, english: true },
  { href: withLocale("en", "/refund"), label: chrome.refund, english: true }
] : [];
---

<footer class="site-footer">
  <div class="shell ft-grid">
    <div class="ft-brand">
      <a class="brand" href={chrome ? withLocale("en", "/") : withLocale(locale, "/")}><img class="mark" src="/brand/detars-mark.png" width="30" height="30" alt="" decoding="async" loading="lazy" /> De<span class="dot">Tars</span></a>
      <p style="margin-top:14px;font-size:13.5px;color:var(--muted);max-width:26ch;line-height:1.6;">
        {sub}
      </p>
    </div>
    {chrome && (
      <div class="ft-solo">
        <div class="ft-links" style="flex-direction:row;flex-wrap:wrap;gap:10px 22px;font-size:14px;color:var(--muted);">
          {soloLinks.map((item) => <a href={item.href} {...(item.english ? { hreflang: "en" } : {})}>{item.label}</a>)}
        </div>
        <p style="margin-top:14px;font-size:12.5px;line-height:1.7;color:var(--faint);">{chrome.legalNote}</p>
      </div>
    )}
    {
      !chrome && footerGroups.map((group) => (
        <div>
          <p style="font-family:var(--sg);font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:var(--faint);">{group.title[locale as Locale]}</p>
          <div class="ft-links" style="flex-direction:column;gap:10px;margin-top:14px;font-size:14px;color:var(--muted);">
            {group.items.map((item) => <a href={footerHref(locale as Locale, item)}>{item.label[locale as Locale]}</a>)}
          </div>
        </div>
      ))
    }
  </div>
  <div class="shell ft" style="border-top:1px solid var(--line);margin-top:28px;">
    <span>© 2026 DeTars · {tagline}</span>
  </div>
  <div class="shell" style="padding:0 0 26px;">
    <p style="font-size:11.5px;line-height:1.7;color:var(--faint);max-width:78ch;" lang={chrome ? "en" : undefined}>{t("legalNote", chrome ? "en" : (locale as Locale))}</p>
  </div>
</footer>

<style>
  .ft-grid { display: grid; grid-template-columns: 1.4fr repeat(4, 1fr); gap: 32px; padding: 48px 0 8px; }
  .ft-grid a { overflow-wrap: anywhere; }
  @media (max-width: 960px) {
    .ft-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 24px; }
    .ft-brand { grid-column: 1 / -1; }
  }
  .ft-solo { grid-column: 2 / -1; align-self: center; }
  @media (max-width: 960px) { .ft-solo { grid-column: 1 / -1; } }
</style>
