---
// DeTars-PII, our own on-device redaction model, open on Hugging Face.
// Left: a sentence redacted on the device before it goes to the cloud.
// Right: leak vs over-mask on the independent test, straight from the model card.
import { homePrivacy, piiChart, PII_EVAL_URL, PII_MODEL_URL } from "@/lib/home-privacy";
import type { Locale } from "@/lib/site";

type Props = { locale: Locale };
const { locale } = Astro.props;
const c = homePrivacy[locale];

// Chart geometry: x = leak 0–25 %, y = over-mask 0–35 per 1k.
const W = 520, H = 330, L = 54, R = 16, T = 18, B = 46;
const px = (v: number) => L + (v / 25) * (W - L - R);
const py = (v: number) => T + (1 - v / 35) * (H - T - B);
const xTicks = [0, 5, 10, 15, 20, 25];
const yTicks = [0, 10, 20, 30];
// The demo cycles through every site language, starting with this page's own.
const order: Locale[] = ["zh", "en", "ja", "ko", "de", "fr", "es", "pt-BR", "zh-Hant"];
const sets: Locale[] = [locale, ...order.filter((l) => l !== locale)];
const langName: Record<Locale, string> = { zh: "中文", "zh-Hant": "繁中", en: "English", ja: "日本語", ko: "한국어", de: "Deutsch", fr: "Français", es: "Español", "pt-BR": "Português" };
---

<section class="band shell pv" id="privacy-model">
  <div class="pv-head reveal">
    <span class="kicker">{c.kicker}</span>
    <h2 set:html={c.h2} />
    <p>{c.p}</p>
  </div>

  <div class="pv-grid reveal">
    <div class="pv-demo" id="pv-demo">
      <div class="pv-langs" aria-hidden="true">
        {sets.map((loc, k) => (<button type="button" class:list={["pv-lang", { on: k === 0 }]} data-k={k} tabindex="-1">{langName[loc]}</button>))}
      </div>
      <div class="pv-sets">
        {sets.map((loc, k) => {
          const parts = homePrivacy[loc].demo;
          const idx = (i: number) => parts.slice(0, i).filter((p) => typeof p !== "string").length;
          return (
            <div class:list={["pv-set", { on: k === 0 }]} data-k={k} lang={loc} aria-hidden={k === 0 ? undefined : "true"}>
              <div class="pv-row">
                <span class="pv-lab">{c.you}</span>
                <p class="pv-text">{parts.map((part, i) => typeof part === "string" ? part : <mark class="pii" style={`--i:${idx(i)}`}>{part[0]}</mark>)}</p>
              </div>
              <div class="pv-pass" aria-hidden="true"><span class="pv-chip-engine">{c.engine}</span></div>
              <div class="pv-row pv-row--cloud">
                <span class="pv-lab">{c.cloud}</span>
                <p class="pv-text">{parts.map((part, i) => typeof part === "string" ? part : <span class="ph" style={`--i:${idx(i)}`}>⟦{part[1]}⟧</span>)}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <figure class="pv-chart">
      <figcaption>{c.chartTitle}</figcaption>
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={c.chartTitle}>
        {xTicks.map((v) => (<g><line class="grid" x1={px(v)} x2={px(v)} y1={T} y2={H - B} /><text class="tick" x={px(v)} y={H - B + 18} text-anchor="middle">{v}</text></g>))}
        {yTicks.map((v) => (<g><line class="grid" x1={L} x2={W - R} y1={py(v)} y2={py(v)} /><text class="tick" x={L - 10} y={py(v) + 4} text-anchor="end">{v}</text></g>))}
        <text class="axis" x={(L + W - R) / 2} y={H - 6} text-anchor="middle">{c.xAxis}</text>
        <text class="axis" transform={`translate(14 ${(T + H - B) / 2}) rotate(-90)`} text-anchor="middle">{c.yAxis}</text>
        <defs><marker id="pv-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="rgba(247,241,236,0.4)" /></marker></defs>
        <path class="better" marker-end="url(#pv-arrow)" d={`M ${px(9)} ${py(6)} L ${px(2.2)} ${py(1.6)}`} />
        <text class="better-t" x={px(9.4)} y={py(6.4)}>{c.better}</text>
        {piiChart.map((m) => {
          const right = m.leak < 18;
          return (
            <g class:list={["pt", { ours: m.ours }]}>
              <circle cx={px(m.leak)} cy={py(m.over)} r={m.ours ? 9 : 6} />
              <text x={px(m.leak) + (right ? 14 : -12)} y={py(m.over) - 2} text-anchor={right ? "start" : "end"}>{m.name}</text>
              <text class="f1" x={px(m.leak) + (right ? 14 : -12)} y={py(m.over) + 13} text-anchor={right ? "start" : "end"}>F1 {m.f1.toFixed(1)}</text>
            </g>
          );
        })}
      </svg>
      <p class="pv-note">{c.note}</p>
    </figure>
  </div>

  <div class="pv-stats reveal">
    {c.stats.map((s) => (<div class="it"><span class="n">{s.n}</span><span class="l">{s.l}</span></div>))}
  </div>

  <div class="pv-cta reveal">
    <a class="btn-primary" href={PII_MODEL_URL} target="_blank" rel="noopener">{c.cta}</a>
    <a class="pv-link" href={PII_EVAL_URL} target="_blank" rel="noopener">{c.evalCta}</a>
  </div>
</section>

<style>
  .pv-head h2 { font-weight: 700; font-size: clamp(30px, 4vw, 52px); line-height: 1.16; letter-spacing: -0.02em; max-width: 20ch; margin: 22px 0 0; }
  .pv-head p { margin: 22px 0 0; max-width: 60ch; font-size: 17px; line-height: 1.75; color: var(--muted); }

  .pv-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 40px; align-items: stretch; margin-top: 46px; }
  .pv-demo, .pv-chart { border: 1px solid var(--line2); border-radius: 20px; background: linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.012)); box-shadow: 0 36px 80px rgba(0, 0, 0, 0.45); }
  .pv-demo { padding: 20px 22px 24px; display: flex; flex-direction: column; gap: 18px; }
  .pv-langs { display: flex; flex-wrap: wrap; gap: 6px; }
  .pv-lang { font: inherit; font-size: 11.5px; color: var(--faint); background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px; cursor: pointer; transition: 0.3s var(--ease); }
  .pv-lang:hover { color: var(--muted); }
  .pv-lang.on { color: var(--accent2); border-color: rgba(255, 106, 61, 0.5); background: rgba(255, 106, 61, 0.08); }
  .pv-sets { flex: 1; display: grid; align-items: center; }
  .pv-set { grid-area: 1 / 1; display: flex; flex-direction: column; gap: 4px; opacity: 0; visibility: hidden; transition: opacity 0.4s var(--ease), visibility 0s linear 0.4s; }
  .pv-set.on { opacity: 1; visibility: visible; transition: opacity 0.4s var(--ease); }
  .pv-lab { display: block; font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.04em; color: var(--faint); margin-bottom: 8px; }
  .pv-text { margin: 0; font-size: 16px; line-height: 2; color: var(--text); }
  mark.pii { color: inherit; background: transparent; border-radius: 5px; padding: 1px 3px; box-shadow: inset 0 -2px 0 rgba(255, 178, 122, 0.55); }
  .pv-pass { position: relative; display: flex; justify-content: center; margin: 14px 0; }
  .pv-pass::before { content: ""; position: absolute; left: 50%; top: -6px; bottom: -6px; width: 1px; background: repeating-linear-gradient(180deg, rgba(70, 211, 154, 0.6) 0 4px, transparent 4px 9px); }
  .pv-chip-engine { position: relative; font-family: var(--mono); font-size: 11.5px; color: var(--green); background: #0f1a15; border: 1px solid rgba(70, 211, 154, 0.4); border-radius: 999px; padding: 5px 12px; }
  .pv-row--cloud .pv-text { color: var(--muted); }
  .ph { display: inline-block; font-family: var(--mono); font-size: 13px; line-height: 1.5; color: var(--accent2); background: rgba(255, 106, 61, 0.1); border: 1px solid rgba(255, 106, 61, 0.32); border-radius: 7px; padding: 0 6px; margin: 0 2px; }

  :global(html.motion) .pv-demo mark.pii { transition: background 0.35s var(--ease), box-shadow 0.35s var(--ease); transition-delay: calc(0.3s + var(--i) * 0.35s); }
  :global(html.motion) .pv-set.play mark.pii { background: rgba(255, 106, 61, 0.22); box-shadow: inset 0 -2px 0 var(--accent); }
  :global(html.motion) .pv-demo .ph { opacity: 0; transform: translateY(6px) scale(0.92); transition: opacity 0.45s var(--ease), transform 0.45s var(--ease); transition-delay: calc(1.9s + var(--i) * 0.28s); }
  :global(html.motion) .pv-set.play .ph { opacity: 1; transform: none; }

  .pv-chart { margin: 0; padding: 20px 20px 16px; }
  .pv-chart figcaption { font-weight: 600; font-size: 15px; margin-bottom: 8px; }
  .pv-chart svg { width: 100%; height: auto; display: block; overflow: visible; }
  .grid { stroke: rgba(255, 255, 255, 0.07); }
  .tick { font-family: var(--mono); font-size: 11px; fill: var(--faint); }
  .axis { font-size: 11.5px; fill: var(--muted); }
  .better { stroke: var(--faint); stroke-width: 1.2; fill: none; }
  .better-t { font-size: 11px; fill: var(--faint); }
  .pt circle { fill: rgba(255, 255, 255, 0.28); }
  .pt text { font-size: 11.5px; fill: var(--muted); }
  .pt .f1 { font-family: var(--mono); font-size: 10.5px; fill: var(--faint); }
  .pt.ours circle { fill: var(--accent); filter: drop-shadow(0 0 10px rgba(255, 106, 61, 0.7)); }
  .pt.ours text { fill: var(--accent2); font-weight: 600; font-size: 13px; }
  .pt.ours .f1 { fill: var(--accent2); font-size: 11.5px; }
  .pv-note { margin: 10px 0 0; font-size: 12px; line-height: 1.6; color: var(--faint); }

  .pv-stats { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 28px; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: rgba(255, 255, 255, 0.02); }
  .pv-stats .it { padding: 20px 22px; display: flex; flex-direction: column; gap: 6px; border-right: 1px solid var(--line); }
  .pv-stats .it:last-child { border-right: none; }
  .pv-stats .n { font-family: var(--sg); font-size: 28px; font-weight: 700; color: var(--accent2); letter-spacing: -0.01em; }
  .pv-stats .l { font-size: 13px; line-height: 1.55; color: var(--muted); }

  .pv-cta { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 30px; }
  .pv-link { font-size: 15px; color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--line2); padding-bottom: 2px; }
  .pv-link:hover { color: var(--text); border-color: var(--muted); }

  @media (max-width: 960px) {
    .pv-grid { grid-template-columns: 1fr; }
    .pv-stats { grid-template-columns: 1fr 1fr; }
    .pv-stats .it:nth-child(2) { border-right: none; }
    .pv-stats .it:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 520px) {
    .pv-chart { padding: 16px 12px 14px; }
    .tick, .axis, .better-t { font-size: 16px; }
    .pt text { font-size: 17px; }
    .pt .f1 { font-size: 15px; }
    .pt.ours text { font-size: 19px; }
    .pt.ours .f1 { font-size: 16px; }
    .pv-stats { grid-template-columns: 1fr; }
    .pv-stats .it { border-right: none; border-bottom: 1px solid var(--line); }
    .pv-stats .it:last-child { border-bottom: none; }
  }
</style>

<script is:inline>
  (() => {
    const demo = document.getElementById("pv-demo");
    if (!demo) return;
    const sets = [...demo.querySelectorAll(".pv-set")];
    const tabs = [...demo.querySelectorAll(".pv-lang")];
    const motion = document.documentElement.classList.contains("motion");
    let k = 0, timer = 0;
    const show = (n) => {
      k = n;
      sets.forEach((s, i) => { s.classList.toggle("on", i === n); s.classList.remove("play"); });
      tabs.forEach((t, i) => t.classList.toggle("on", i === n));
      void sets[n].offsetWidth;
      sets[n].classList.add("play");
    };
    const loop = () => { clearTimeout(timer); timer = setTimeout(() => { show((k + 1) % sets.length); loop(); }, 6200); };
    tabs.forEach((t, i) => t.addEventListener("click", () => { show(i); loop(); }));
    if (!motion || !("IntersectionObserver" in window)) { sets[0].classList.add("play"); return; }
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { show(0); loop(); io.disconnect(); } }), { threshold: 0.25 });
    io.observe(demo);
  })();
</script>
