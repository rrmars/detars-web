{
  "name": "detars-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "dev": "astro dev",
    "build": "npm run check:knowledge && npm run check:model-tiers && npm run check:model-pricing && astro build",
    "preview": "astro preview",
    "check": "npm run check:knowledge && npm run check:model-tiers && npm run check:model-pricing && astro check",
    "check:knowledge": "node scripts/validate-knowledge.mjs && node scripts/build-knowledge-skills.mjs --check",
    "check:model-tiers": "node scripts/validate-model-tiers.mjs",
    "check:model-pricing": "node scripts/validate-model-pricing.mjs",
    "sync:model-pricing": "node scripts/sync-model-pricing.mjs && node scripts/validate-model-pricing.mjs",
    "sync:knowledge-skills": "node scripts/build-knowledge-skills.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.1",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "astro": "^6.0.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "typescript": "^5.9.3"
  }
}
